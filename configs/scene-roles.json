            "cx": 322.66602,
            "cy": 253.66576,
            "width": 640,
            "height": 480
          },
          "optical_frame": {
            "convention": "opencv"
          },
          "distortion": {
            "model": "none",
            "coefficients": []
          },
          "fps": 10
        }
      ]
    }
  },
  "roles": {
    "task_object": {
      "reach_targets_min": 1,
      "require_randomization": true
    },
    "receptacle": {
      "reach_targets_min": 1,
      "require_probe": true,
      "probe_asset_role": "task_object"
    },
    "background": {
      "reach_targets_min": 0
    }
  }
}
