{
  "schema": "datafarm.scene-author/1",
  "notes": [
    "Run copy for 1b-proot: the sandbox block selects proot explicitly (bwrap/unshare need CAP_SYS_ADMIN, absent here). No secrets: credentials reach the agent only through the variables named in env_passthrough."
  ],
  "agent": {
    "backend": "claude",
    "model": "claude-opus-5-5",
    "cli": "/home/isaac/node/bin/claude",
    "tools": ["Bash", "Read", "Edit", "Write", "Glob", "Grep"],
    "disallowed_tools": ["WebFetch", "WebSearch", "Task"],
    "permission_mode": "bypassPermissions",
    "setting_sources": "user",
    "codex": {"cli": "codex", "extra_args": []}
  },
  "price_table": "prices.json",
  "sandbox": {
    "mode": "proot",
    "fallback": [],
    "proot": "/home/isaac/tools/proot/bin/proot",
    "python": "/home/isaac/IsaacLab30/.venv/bin/python",
    "extra_ro": []
  },
  "wall_s_per_round": 1800,
  "max_budget_usd_per_round": null,
  "env_passthrough": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL",
                      "CLAUDE_CODE_OAUTH_TOKEN", "OPENAI_API_KEY", "OPENAI_BASE_URL", "CODEX_HOME",
                      "CLAUDE_CONFIG_DIR"]
}
